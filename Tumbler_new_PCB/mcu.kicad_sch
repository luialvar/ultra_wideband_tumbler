	(text "VBAT ~500nA for RTC\n100uF * (3.2V - 1.55V) / 500nA -> 5.5min\n3.3V/100R = 3.3mA inrush\n100R*500nA = 50uV\n-> VBAT @ 3.3V quicker with R below"
		(exclude_from_sim no)
		(at 24.384 61.214 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0e464fe9-24ab-4a59-a71a-695ce799447d")
	)
	(text "The GPIOs can sink or source up to ±8 mA,\nand sink or source up to ± 20 mA\n(with a relaxed VOL/VOH)."
		(exclude_from_sim no)
		(at 138.938 113.792 0)
